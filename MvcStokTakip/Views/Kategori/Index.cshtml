@using MvcStokTakip.Models.Entity
@using PagedList
@using PagedList.Mvc
@model PagedList.IPagedList<tbl_Kategoriler>
@{
    ViewBag.Title = "Index";
    Layout = "~/Views/Shared/_MainLayout.cshtml";
}

<table class="table table-bordered table-hover">
    <thead>
        <tr>
            <th>KATEGORİ ID</th>
            <th>KATEGORİ ADI</th>
            <th>SİL</th>
            <th>GÜNCELLE</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var ktgr in Model)
        {
            <tr>
                <td>@ktgr.KategoriId</td>
                <td>@ktgr.KategoriAd</td>
                <td><a href="/Kategori/Sil/@ktgr.KategoriId" class="btn btn-danger btn-sm">Sil</a></td>
                <td><a href="/Kategori/KategoriGetir/@ktgr.KategoriId" class="btn btn-success btn-sm">Güncelle</a></td>
            </tr>
        }
    </tbody>
</table>
<!--kaç tane sayfa varsa oan getirsin-->
@Html.PagedListPager((IPagedList)Model,sayfa=>Url.Action("Index",new { sayfa}))
<a href="/Kategori/YeniKategori/" class="btn btn-primary">YENİ KATEGORİ EKLE</a>