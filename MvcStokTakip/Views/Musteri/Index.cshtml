@using MvcStokTakip.Models.Entity
@model List<tbl_Musteriler>
@{
    ViewBag.Title = "Index";
    Layout = "~/Views/Shared/_MainLayout.cshtml";
}


@using (Html.BeginForm("Index", "Musteri", FormMethod.Get))
{
<p>
    <b> Aranacak Müsteri Adı: </b> @Html.TextBox("p")
    <input type="submit" value="Ara" />
</p>
}



<table class="table table-bordered">
    <tr>
        <th>MÜŞTERİ ID</th>
        <th>MÜŞTERİ AD</th>
        <th>MÜŞTERİ SOYAD</th>
        <th>SİL</th>
        <th>GÜNCELLE</th>
        <th>ALERT</th>
    </tr>
    <tbody>
        @foreach (var mustr in Model)
        {
            <tr>
                <th>@mustr.MusteriId</th>
                <td>@mustr.MusteriAd</td>
                <td>@mustr.MusteriSoyad</td>
                <td><a href="/Musteri/Sil/@mustr.MusteriId" class="btn btn-danger btn-sm">Sil</a></td>
                <td><a href="/Musteri/MusteriGetir/@mustr.MusteriId" class="btn btn-success btn-sm">Güncelle</a></td>
                <td>@Html.ActionLink("SİL Butonu", "Sil", new { id = mustr.MusteriId }, new { @class = "btn btn-warning", onclick = "return confirm('Gerçekten Silmek İstiyor musunuz?')" })</td>



            </tr>
        }
    </tbody>
</table>

<a href="/Musteri/YeniMusteri/" class="btn btn-primary">YENİ MÜŞTERİ EKLE</a>